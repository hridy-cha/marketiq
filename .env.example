# MarketIQ environment template. Copy to .env and fill in what you use.
# Nothing here is required to run on the bundled dataset; keys only enable live data refreshes.

# ---------------------------------------------------------------- core
ENVIRONMENT=development
LOG_LEVEL=INFO

# SQLite by default. For PostgreSQL: pip install "marketiq[postgres]" and set
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/marketiq
DATABASE_URL=sqlite:///data/marketiq.db

# ---------------------------------------------------------------- data
DATA_BASE_DIR=data
DATA_UNIVERSE_FILE=config/universe.yaml
DATA_SCORING_FILE=config/scoring.yaml
DATA_SIGNALS_FILE=config/signals.yaml
DATA_MODELS_DIR=models
DATA_FINRLX_DB=data/finrl_trading.db
# Live providers: yfinance (free, default) or fmp (needs FMP_API_KEY)
DATA_PRICE_PROVIDER=yfinance
DATA_NEWS_PROVIDER=yfinance
DATA_EXCHANGE=NYSE

# Financial Modeling Prep (optional): prices, statements, earnings dates, news
FMP_API_KEY=

# OpenAI (optional): LLM news sentiment. Without it an offline lexicon is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------- ML
ML_HORIZON_DAYS=20
ML_RETURN_THRESHOLD=0.0
ML_MIN_TRAIN_ROWS=500

# ---------------------------------------------------------------- API
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------- broker (optional, paper only by default)
# The built-in paper broker needs no credentials. Alpaca is an optional adapter.
APCA_API_KEY=
APCA_API_SECRET=
APCA_BASE_URL=https://paper-api.alpaca.markets
# Real-money trading is refused unless this is explicitly true AND APCA_BASE_URL is a live endpoint.
ENABLE_LIVE_TRADING=false
